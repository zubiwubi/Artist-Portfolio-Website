@baseUrl = http://localhost:5247

### Get all products
GET {{baseUrl}}/api/products

### Get one product
GET {{baseUrl}}/api/products/1

### Create a product
POST {{baseUrl}}/api/products
Content-Type: application/json

### Delete a product
DELETE {{baseUrl}}/api/products/5

### Update a product
PUT {{baseUrl}}/api/products/1
